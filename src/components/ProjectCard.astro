---
interface Props {
  title: string;
  description: string;
  github: string;
  image: string;
  stacks: string[];
}

const { title, description, github, image, stacks } = Astro.props;
---

<div class="overflow-hidden rounded border">
  <a href={github} target="_blank"
    ><img class="w-full" src={image} alt={title} /></a
  >
  <div class="px-4 py-3">
    <div class="mb-1 font-bold">{title}</div>
    <p class="text-sm text-gray-600">{description}</p>
  </div>
  <div class="flex items-center justify-between px-4 py-3">
    <div class="flex gap-1">
      {
        stacks.map((stack) => (
          <span class="rounded border px-2 py-0.5 text-xs">{stack}</span>
        ))
      }
    </div>
  </div>
</div>
