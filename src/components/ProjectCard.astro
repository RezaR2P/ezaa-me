---
import GithubIcon from "./GithubIcon.astro";
import PythonIcon from "./PythonIcon.astro";

const iconComponents: Record<string, any> = {
  Python: PythonIcon,
};
interface Props {
  title: string;
  description: string;
  github: string;
  image: string;
  stacks: string[];
}

const { title, description, github, image, stacks } = Astro.props;
---

<div class="overflow-hidden rounded border">
  <a href={github} target="_blank"
    ><img class="w-full" src={image} alt={title} /></a
  >
  <div class="px-4 py-3">
    <div class="mb-1 font-bold">{title}</div>
    <p class="text-sm text-gray-600">{description}</p>
  </div>
  <div class="flex items-center justify-between px-4 py-3">
    <div class="flex flex-wrap gap-1">
      {
        stacks.map((stack) => {
          const Icon = iconComponents[stack];
          return (
            <span class="flex items-center gap-1 px-2 py-0.5">
              {Icon ? <Icon class="inline h-7 w-7" /> : stack}
            </span>
          );
        })
      }
    </div>
    <a href={github} target="_blank">
      <GithubIcon class="h-8 w-8" />
    </a>
  </div>
</div>
