---
import Layout from "../../layouts/Layout.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) => {
    return data.draft !== true;
  });

  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const formattedDate = new Intl.DateTimeFormat("id-ID", {
  day: "numeric",
  month: "long",
  year: "numeric",
}).format(new Date(post.data.date));

// Konversi ke string untuk atribut datetime
const isoDate = new Date(post.data.date).toISOString().split("T")[0];
---

<Layout title={post.data.title}>
  <main class="w-full">
    <article class="mx-auto max-w-3xl px-4 py-12 sm:px-6 lg:px-8">
      <header class="mb-10 border-b border-gray-200 pb-8 dark:border-gray-800">
        <div
          class="mb-4 flex items-center justify-between text-sm text-gray-500 dark:text-gray-400"
        >
          <time datetime={isoDate}>{formattedDate}</time>
          {
            post.data.author && (
              <span class="font-medium text-gray-700 dark:text-gray-300">
                Oleh: {post.data.author}
              </span>
            )
          }
        </div>

        <h1
          class="mb-4 text-3xl leading-tight font-extrabold text-gray-900 sm:text-4xl dark:text-white"
        >
          {post.data.title}
        </h1>

        {
          post.data.description && (
            <p class="text-lg leading-relaxed text-gray-600 dark:text-gray-300">
              {post.data.description}
            </p>
          )
        }
      </header>

      <!-- Bagian gambar cover dihapus sepenuhnya -->

      <!-- Konten Markdown (gambar bisa dimasukkan langsung di sini) -->
      <div class="prose prose-lg prose-slate dark:prose-invert max-w-none">
        <Content />
      </div>
    </article>
  </main>
</Layout>

