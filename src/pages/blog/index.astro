---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";

const posts = await getCollection("blog", ({ data }) => {
  return data.draft !== true;
});

const sortedPosts = posts.sort(
  (a: CollectionEntry<"blog">, b: CollectionEntry<"blog">) =>
    new Date(b.data.date).getTime() - new Date(a.data.date).getTime(),
);
---

<Layout title="Blog | Eza">
  <main class="w-full">
    <section class="px-4 py-12">
      <div class="mx-auto max-w-3xl">
        <h1
          class="mb-12 text-center text-4xl font-extrabold tracking-tight text-gray-900 dark:text-white"
        >
          Blog
        </h1>
        <div
          id="filter-status"
          class="mb-6 hidden items-center justify-between rounded-lg bg-blue-50 px-4 py-3 dark:bg-blue-900/20"
        >
          <span class="text-sm text-blue-800 dark:text-blue-200">
            Menampilkan postingan dengan tag:
            <strong id="active-filter-name" class="font-bold"></strong>
          </span>
          <button
            id="clear-filter"
            class="text-sm font-medium text-blue-600 hover:underline dark:text-blue-300"
          >
            Hapus Filter
          </button>
        </div>

        <ul class="space-y-8" id="blog-list">
          {
            sortedPosts.map((post) => (
              <li
                class="group filter-item"
                data-tags={
                  post.data.tags ? JSON.stringify(post.data.tags) : "[]"
                }
              >
                <a href={`/blog/${post.id}`} class="group/link block">
                  <h2 class="mb-2 text-xl font-bold text-gray-800 transition-colors group-hover/link:text-blue-600 dark:text-gray-100 dark:group-hover/link:text-blue-400">
                    {post.data.title}
                  </h2>
                  {post.data.description && (
                    <p class="mb-4 line-clamp-2 text-gray-600 dark:text-gray-300">
                      {post.data.description}
                    </p>
                  )}
                </a>
                <div class="flex items-center justify-between border-t border-gray-100 pt-4">
                  <time
                    datetime={new Date(post.data.date).toISOString()}
                    class="text-sm text-gray-500 dark:text-gray-400"
                  >
                    {new Intl.DateTimeFormat("id-ID", {
                      day: "numeric",
                      month: "long",
                      year: "numeric",
                    }).format(new Date(post.data.date))}
                  </time>

                  {post.data.tags && post.data.tags.length > 0 && (
                    <div class="ml-auto flex flex-wrap gap-2">
                      {post.data.tags.map((tag) => (
                        <button
                          type="button"
                          data-tag={tag}
                          class="filter-tag-btn relative z-10 cursor-pointer rounded-full bg-gray-100 px-2.5 py-2 text-xs font-medium text-gray-600 transition-colors hover:bg-blue-100 hover:text-blue-700 dark:bg-gray-800 dark:text-gray-300 dark:hover:bg-blue-900 dark:hover:text-blue-200"
                        >
                          #{tag}
                        </button>
                      ))}
                    </div>
                  )}
                </div>
              </li>
            ))
          }
        </ul>
      </div>
    </section>
  </main>

  <script>
    const filterBtns = document.querySelectorAll(".filter-tag-btn");
    const blogItems = document.querySelectorAll(".filter-item");
    const filterStatus = document.getElementById("filter-status");
    const activeFilterName = document.getElementById("active-filter-name");
    const clearFilterBtn = document.getElementById("clear-filter");

    function applyFilter(tag: string) {
      if (!filterStatus || !activeFilterName) return;

      filterStatus.classList.remove("hidden");
      filterStatus.classList.add("flex");
      activeFilterName.textContent = `#${tag}`;

      blogItems.forEach((item) => {
        const htmlItem = item as HTMLElement;
        const itemTags = JSON.parse(htmlItem.getAttribute("data-tags") || "[]");

        if (itemTags.includes(tag)) {
          htmlItem.style.display = "block";
          htmlItem.animate([{ opacity: 0.5 }, { opacity: 1 }], {
            duration: 300,
            fill: "forwards",
          });
        } else {
          htmlItem.style.display = "none";
        }
      });
    }

    function clearFilter() {
      if (!filterStatus) return;
      filterStatus.classList.add("hidden");
      filterStatus.classList.remove("flex");

      blogItems.forEach((item) => {
        (item as HTMLElement).style.display = "block";
      });
    }

    filterBtns.forEach((btn) => {
      btn.addEventListener("click", (e) => {
        const target = e.target as HTMLElement;
        const tag = target.getAttribute("data-tag");
        if (tag) applyFilter(tag);
      });
    });

    if (clearFilterBtn) {
      clearFilterBtn.addEventListener("click", clearFilter);
    }
  </script>
</Layout>
