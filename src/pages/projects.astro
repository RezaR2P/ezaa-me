---
import Layout from "../layouts/Layout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { projects } from "../data/projects";
---

<Layout title="Eza — Web Developer">
  <main>
    <section class="px-0 py-1.5">
      <div class="mx-auto max-w-[90ch] px-3 lg:px-0">
        <div class="prose">
          <h1 class="my-12 text-center text-3xl font-bold">My Projects</h1>
          <div
            class="grid grid-cols-1 gap-2 py-5 sm:grid-cols-2 md:grid-cols-3"
          >
            {
              projects.map((project) => (
                <ProjectCard
                  title={project.title}
                  description={project.description}
                  github={project.github}
                  image={project.image}
                  stacks={project.stacks}
                />
              ))
            }
          </div>
        </div>
      </div>
    </section>
  </main>
</Layout>
