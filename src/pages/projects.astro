---
import Layout from "../layouts/Layout.astro";
import ProjectCard from "../components/ProjectCard.astro";
---

<Layout title="Eza — Web Developer">
  <main>
    <section class="px-0 py-1.5">
      <div class="mx-auto max-w-[90ch] px-3 lg:px-0">
        <div class="prose">
          <h1 class="my-12 text-center text-3xl font-bold">My Projects</h1>
          <div
            class="grid grid-cols-1 gap-5 py-5 sm:grid-cols-2 md:grid-cols-3"
          >
            <ProjectCard
              title="Baso Yen"
              description="Website company profile"
              github="https://github.com/..."
              image="https://images.unsplash.com/photo-1613816493575-b180590d69a9?q=80&w=1074&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D"
              stacks={["React", "Express", "MySQL"]}
            />
          </div>
        </div>
      </div>
    </section>
  </main>
</Layout>
