---
import Layout from "../../layouts/Layout.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const tilEntries = await getCollection("til", ({ data }) => {
    return data.draft !== true;
  });

  return tilEntries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const formattedDate = new Intl.DateTimeFormat("id-ID", {
  day: "numeric",
  month: "long",
  year: "numeric",
}).format(new Date(entry.data.date));

const isoDate = new Date(entry.data.date).toISOString().split("T")[0];
---

<Layout title={entry.data.title}>
  <main class="w-full">
    <article class="mx-auto max-w-3xl px-4 py-12 sm:px-6 lg:px-8">
      <!-- Header -->
      <header class="mb-8 border-b border-gray-200 pb-6 dark:border-gray-500">
        <div
          class="mb-2 flex items-center gap-3 text-sm text-gray-500 dark:text-gray-400"
        >
          <time datetime={isoDate}>{formattedDate}</time>
          <span>•</span>
          <span
            class="rounded-full bg-blue-100 px-2.5 py-0.5 text-xs font-medium text-blue-800 dark:bg-blue-900 dark:text-blue-200"
          >
            TIL
          </span>
        </div>
        <h1
          class="text-3xl leading-tight font-extrabold text-gray-900 sm:text-4xl dark:text-white"
        >
          {entry.data.title}
        </h1>
      </header>

      <!-- Konten -->
      <div class="prose prose-lg prose-slate dark:prose-invert max-w-none">
        <Content />
      </div>

      <!-- Kembali ke Daftar -->
      <div class="mt-12 border-t border-gray-200 pt-6 dark:border-gray-800">
        <a
          href="/til"
          class="text-sm font-medium text-blue-600 hover:underline dark:text-blue-400"
        >
          &larr; Kembali ke daftar TIL
        </a>
      </div>
    </article>
  </main>
</Layout>
